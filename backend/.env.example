# Generá tu clave en https://isthereanydeal.com/dev/app/
ITAD_API_KEY=replace_me

# Puerto local del API.
PORT=8080

# URL exacta del frontend público. En desarrollo no hace falta.
FRONTEND_URL=https://your-frontend.example

# IVA aplicado a servicios digitales para estimar el total de precios USD.
# Usar formato decimal: 0.21 equivale a 21%.
DIGITAL_SERVICES_TAX_RATE=0.21
